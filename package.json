{
  "name": "@topaz-ia/pump-evolution",
  "version": "0.0.6",
  "packageManager": "pnpm@9.12.3",
  "description": "Plug-and-play TypeScript/Node telemetry SDK for AI agents and MCP servers — emits governed usage telemetry (identity, tokens, tools, compliance, OWASP security) to Control Tower AI as OpenTelemetry GenAI spans. Zero internal cta-* dependencies.",
  "keywords": [
    "telemetry",
    "observability",
    "opentelemetry",
    "otel",
    "genai",
    "llm",
    "mcp",
    "bedrock",
    "governance",
    "control-tower"
  ],
  "author": "A3Data",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.topazevolution.com/topaz-ia/templates/sdk.git"
  },
  "homepage": "https://gitlab.topazevolution.com/topaz-ia/templates/sdk/-/blob/main/README.md",
  "bugs": {
    "url": "https://gitlab.topazevolution.com/topaz-ia/templates/sdk/-/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist .turbo *.tsbuildinfo docs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "api:extract": "pnpm run build && api-extractor run --local",
    "api:check": "pnpm run build && api-extractor run",
    "demo:local": "pnpm run build && node scripts/local-demo.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.52.0",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.15.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  }
}
