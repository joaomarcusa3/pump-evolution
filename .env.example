# ─── @a3data/pump-evolution — ambiente do agente instrumentado ───────────────
# Copie para .env no seu agente e preencha. NUNCA commite segredos.

# Liga/desliga a telemetria. O SDK é no-op a menos que seja exatamente 'true'.
PUMP_EVOLUTION_ENABLED=true

# Endpoint OTLP do Control Tower AI (receiver). Pode vir do manifest.yaml
# (runtime.telemetry.otelEndpoint) — então é opcional aqui.
PUMP_OTEL_ENDPOINT=https://<api-do-cta>/api/telemetry/v1/traces

# ─── Service account (OAuth client-credentials) ──────────────────────────────
# Emitido pelo CTA (Cognito Resource Server + App Client client_credentials).
# clientId pode vir do manifest.yaml (runtime.telemetry.serviceAccountId).
PUMP_SERVICE_ACCOUNT_CLIENT_ID=svc-<seu-agente>
# Secret e tokenUrl SEMPRE do ambiente — nunca no manifesto.
PUMP_SERVICE_ACCOUNT_CLIENT_SECRET=REPLACE_ME
PUMP_SERVICE_ACCOUNT_TOKEN_URL=https://<seu-dominio>.auth.us-east-1.amazoncognito.com/oauth2/token

# AWS (para o BedrockRuntimeClient do próprio agente)
AWS_REGION=us-east-1
